#version 450

// Compute test shader: fills a storage buffer with a per-index color derived
// from the invocation index (a vertical band gradient used by the graphics
// verification pass). One invocation per output value.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) restrict writeonly buffer Output {
    vec4 values[];
} out_buf;

layout(push_constant) uniform Push {
    uint value_count;   // number of vec4 outputs
    float hue_shift;    // varies the produced color between runs
} push;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= push.value_count) return;
    float t = float(i) / float(push.value_count - 1u);
    out_buf.values[i] = vec4(t, 1.0 - t, push.hue_shift, 1.0);
}
