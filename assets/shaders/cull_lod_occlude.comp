#version 450

// cull_lod_occlude.comp — full GPU-driven pre-pass: per-instance frustum
// culling + distance-based LOD selection + tile-based occlusion against the
// PREVIOUS frame's reduced depth pyramid. Produces, per LOD band, a compacted
// accepted-index list and an indirect draw command; graphics never sees a
// culled instance and draws each at its selected LOD. Per-draw counters let
// the CPU read back acceptance/cull statistics without stalls (read once per
// N frames).
//
// Binding 0 (std430, flat uint words):
//   [0]  instance_count           (CPU, static per scene build)
//   [1]  accepted_cursor          (atomic, reset by CPU each frame)
//   [2]  tile_count_x             (CPU, static)
//   [3]  tile_count_y             (CPU, static)
//   [4]  stats_accepted_total     (atomic, reset by CPU each frame)
//   [5]  stats_frustum_culled     (atomic)
//   [6]  stats_occlusion_culled   (atomic)
//   [7..9]  reserved
//   [10 .. 10+4T-1]               depth pyramid: T tiles, uint = packed
//                                 max-depth qfloat (0x3F800000 == 1.0 far)
//   [sp .. sp+4N-1]   spheres: N x (cx, cy, cz, radius)      (push: sphere_off)
//   [ld .. ld+N-1]    per-instance LOD bias words            (push: lod_off)
//   [cp .. cp+N-1]    compacted indices, band 0 (LOD0)       (push: comp0_off)
//   [cq .. cq+M-1]    compacted indices, band 1 (LOD1)       (push: comp1_off)
//   [cr .. cr+K-1]    compacted indices, band 2 (LOD2)       (push: comp2_off)
//
// Binding 1..3: VkDrawIndirectCommand per band (vertexCount=36 pre-filled;
// instanceCount maintained atomically here).
//
// Occlusion test: project the sphere center; reject when every depth-tile
// sample it covers in the previous frame's pyramid is nearer than the
// sphere's own closest depth (conservative, 1-frame latency).

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) buffer CullBuffer {
  uint words[];
} cull;

layout(set = 0, binding = 1, std430) buffer Draw0 { uint cmd0[]; };
layout(set = 0, binding = 2, std430) buffer Draw1 { uint cmd1[]; };
layout(set = 0, binding = 3, std430) buffer Draw2 { uint cmd2[]; };

layout(push_constant) uniform Push {
  uint sphere_off;
  uint lod_off;
  uint comp0_off;
  uint comp1_off;
  uint comp2_off;
  uint proj_scale_x;  // 0.5 * width  / tan(fov/2) / aspect (packed as bits)
  uint proj_scale_y;  // 0.5 * height / tan(fov/2)          (packed as bits)
  uint width;         // render-target pixels
  uint height;
  uint tile_size;     // pyramid tile edge in pixels
  uint near_z;        // packed float
  uint far_z;         // packed float
} push;


void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i >= cull.words[0]) return;

  const uint sp = push.sphere_off + i * 4u;
  const vec3 center = vec3(uintBitsToFloat(cull.words[sp]),
                           uintBitsToFloat(cull.words[sp + 1u]),
                           uintBitsToFloat(cull.words[sp + 2u]));
  const float radius = uintBitsToFloat(cull.words[sp + 3u]);

  // ---- Frustum (camera at origin, looking down -z). ----
  bool visible = (center.z <= -0.1f) && (center.z >= -100.0f);
  if (visible) {
    const float w = -center.z;                       // view-space depth
    const vec2 ext = vec2(w, w) * 1.2f;              // ~tan(50 deg) margin
    visible = all(lessThanEqual(abs(center.xy) + radius, ext));
  }
  if (!visible) {
    atomicAdd(cull.words[5], 1u);  // frustum-culled
    return;
  }

  // ---- Occlusion against the previous frame's depth pyramid. ----
  // Clip position of the sphere center; NDC depth of the NEAREST point.
  const float tan_half = 1.2f;  // matches frustum margin tan(50 deg)
  const vec2 ndc = center.xy / (-center.z * tan_half);
  const float ndc_depth = ((-center.z - radius) - 0.1f) / (100.0f - 0.1f)
                        * (100.0f / (-center.z - radius));
  // Simplified: linear depth proxy in [0,1]; conservative because the real
  // projection compresses near values less than this proxy.
  const float depth_min = clamp(((-center.z - radius) - 0.1f) / (100.0f - 0.1f),
                                0.0f, 1.0f);

  const uint tcx = cull.words[2];
  const uint tcy = cull.words[3];
  if (tcx > 0u && tcy > 0u) {
    const vec2 uv = ndc * 0.5f + 0.5f;
    if (all(greaterThanEqual(uv, vec2(0.0f))) && all(lessThanEqual(uv, vec2(1.0f)))) {
      // Sample the 2x2 tile footprint around the projected center.
      const uvec2 tile_min = uvec2(clamp(uvec2(uvec2(uv * vec2(float(tcx), float(tcy)))),
                                         uvec2(0u), uvec2(tcx - 1u, tcy - 1u)));
      bool covered_everywhere = true;
      bool any_sample = false;
      for (uint dy = 0u; dy < 2u; ++dy) {
        for (uint dx = 0u; dx < 2u; ++dx) {
          const uvec2 t = uvec2(min(tile_min.x + dx, tcx - 1u),
                                min(tile_min.y + dy, tcy - 1u));
          const uint packed = cull.words[10u + t.y * tcx + t.x];
          const float scene_max_depth = uintBitsToFloat(packed);
          if (packed != 0u) {
            any_sample = true;
            // Tile is occluding when its farthest depth is NEARER than the
            // sphere's nearest possible depth.
            if (scene_max_depth < depth_min) {
              covered_everywhere = covered_everywhere && true;
            } else {
              covered_everywhere = false;
            }
          }
        }
      }
      if (any_sample && covered_everywhere) {
        atomicAdd(cull.words[6], 1u);  // occlusion-culled
        return;
      }
    }
  }

  // ---- LOD: distance bands (near/mid/far). ----
  const float dist = length(center);
  uint lod = 0u;
  if (dist > 18.0f) lod = 1u;
  if (dist > 40.0f) lod = 2u;

  // Per-instance bias can force a coarser band (never finer).
  const uint bias = cull.words[push.lod_off + i];
  lod = max(lod, bias);

  const uint slot = atomicAdd(cull.words[1], 1u);
  if (lod == 0u) {
    cull.words[push.comp0_off + slot] = i;
    atomicAdd(cmd0[1], 1u);
  } else if (lod == 1u) {
    cull.words[push.comp1_off + slot] = i;
    atomicAdd(cmd1[1], 1u);
  } else {
    cull.words[push.comp2_off + slot] = i;
    atomicAdd(cmd2[1], 1u);
  }
  atomicAdd(cull.words[4], 1u);  // stats_accepted_total
}
