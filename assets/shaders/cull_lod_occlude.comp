#version 450

// cull_lod_occlude.comp — full GPU-driven pre-pass: per-instance frustum
// culling + FOOTPRINT-ADAPTIVE occlusion against the previous frame's mip-
// chained depth pyramid (1-frame latency, conservative) + distance-band LOD
// selection with per-instance bias. Produces, per LOD band, a compacted
// accepted-index list and an indirect draw command; graphics never sees a
// culled instance and draws each at its selected LOD. Per-draw counters let
// the CPU read back acceptance/cull statistics without stalls (read once per
// N frames).
//
// Binding 0 (std430, flat uint words):
//   [0]  instance_count           (CPU, static per scene build)
//   [1]  accepted_cursor          (atomic, reset by CPU each frame)
//   [2]  tile_count_x             (CPU, static)
//   [3]  tile_count_y             (CPU, static)
//   [4]  stats_accepted_total     (atomic, reset by CPU each frame)
//   [5]  stats_frustum_culled     (atomic)
//   [6]  stats_occlusion_culled   (atomic)
//   [7..9]  reserved
//   [P .. P+63]      pyramid level 0: 8x8 tiles (32px texels), packed max depth
//   [P+64 .. P+79]   level 1: 4x4 (64px)
//   [P+80 .. P+83]   level 2: 2x2 (128px)
//   [P+84]           level 3: 1x1 (256px)
//   [sp .. sp+4N-1]   spheres: N x (cx, cy, cz, radius)      (push: sphere_off)
//   [ld .. ld+N-1]    per-instance LOD bias words            (push: lod_off)
//   [cp .. cp+N-1]    compacted indices, band 0 (LOD0)       (push: comp0_off)
//   [cq .. cq+M-1]    compacted indices, band 1 (LOD1)       (push: comp1_off)
//   [cr .. cr+K-1]    compacted indices, band 2 (LOD2)       (push: comp2_off)
//
// Binding 1..3: VkDrawIndirectCommand per band (vertexCount=36 pre-filled;
// instanceCount maintained atomically here).
//
// Occlusion test: project the sphere's screen-space bounding square, pick the
// pyramid level whose texel size best matches the footprint (footprint spans
// <= 2x2 texels there), and reject when EVERY covered texel's max depth is
// nearer than the sphere's nearest-point depth. Conservative at every level.

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) buffer CullBuffer {
  uint words[];
} cull;

layout(set = 0, binding = 1, std430) buffer Draw0 { uint cmd0[]; };
layout(set = 0, binding = 2, std430) buffer Draw1 { uint cmd1[]; };
layout(set = 0, binding = 3, std430) buffer Draw2 { uint cmd2[]; };

layout(push_constant) uniform Push {
  uint sphere_off;
  uint lod_off;
  uint comp0_off;
  uint comp1_off;
  uint comp2_off;
  uint proj_scale_x;  // 0.5 * width  / tan(fov/2) / aspect (packed as bits)
  uint proj_scale_y;  // 0.5 * height / tan(fov/2)          (packed as bits)
  uint width;         // render-target pixels
  uint height;
  uint tile_size;     // pyramid tile edge in pixels
  uint near_z;        // packed float
  uint far_z;         // packed float
  uint pyramid_off;   // word index of pyramid L0 inside the payload buffer
  uint occl_mode;     // 0 = legacy 2x2-tile center test, 1 = footprint-adaptive mip chain
} push;


void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i >= cull.words[0]) return;

  const uint sp = push.sphere_off + i * 4u;
  const vec3 center = vec3(uintBitsToFloat(cull.words[sp]),
                           uintBitsToFloat(cull.words[sp + 1u]),
                           uintBitsToFloat(cull.words[sp + 2u]));
  const float radius = uintBitsToFloat(cull.words[sp + 3u]);

  // ---- Frustum (camera at origin, looking down -z). ----
  bool visible = (center.z <= -0.1f) && (center.z >= -100.0f);
  if (visible) {
    const float w = -center.z;                       // view-space depth
    const vec2 ext = vec2(w, w) * 1.2f;              // ~tan(50 deg) margin
    visible = all(lessThanEqual(abs(center.xy) + radius, ext));
  }
  if (!visible) {
    atomicAdd(cull.words[5], 1u);  // frustum-culled
    return;
  }

  // ---- Occlusion against the previous frame's depth pyramid. ----
  // Clip position of the sphere center; NDC depth of the NEAREST point.
  const vec2 tan_half_v = vec2(1.2f, 1.2f);  // matches frustum margin
  const vec2 ndc = center.xy / (-center.z * tan_half_v);
  // Exact NDC depth of the nearest sphere point for the GL-style projection
  // used by our matrices: ndc(viewD) = C1 - C2/viewD, with viewD the view-space
  // distance. Pyramid values are real rendered NDC depth, so the comparison
  // (tile max < sphere nearest => fully behind geometry) is exact, not proxy.
  const float near_z = uintBitsToFloat(push.near_z);
  const float far_z = uintBitsToFloat(push.far_z);
  const float inv_range = 1.0f / (far_z - near_z);
  const float c1 = (far_z + near_z) * inv_range;
  const float c2 = 2.0f * far_z * near_z * inv_range;
  const float view_d = max(-center.z - radius, near_z);
  const float depth_min = clamp(c1 - c2 / view_d, 0.0f, 1.0f);

  const uint tcx = cull.words[2];
  const uint tcy = cull.words[3];
  if (tcx > 0u && tcy > 0u && push.occl_mode != 0u) {
    // ---- Footprint-adaptive occlusion against the mip chain. ----
    // Project the sphere's screen-space bounding square (center +/- radius
    // projected at the center's depth), then walk from L0 down until the
    // footprint spans <= 2 texels per axis. Level dims are hard-wired to the
    // 256x256 / 32px layout: 8, 4, 2, 1.
    const float texel = 2.0f * tan_half_v.x;  // NDC per 32px tile
    const float half_x = radius * tan_half_v.x / (-center.z);
    const float half_y = radius * tan_half_v.y / (-center.z);
    uint level = 0u;
    if (half_x * 2.0f > texel || half_y * 2.0f > texel) level = 1u;
    if (level == 1u && (half_x * 4.0f > texel || half_y * 4.0f > texel)) level = 2u;
    if (level == 2u && (half_x * 8.0f > texel || half_y * 8.0f > texel)) level = 3u;
    const uint ldims[4] = uint[4](8u, 4u, 2u, 1u);
    const uint lstart[4] = uint[4](0u, 64u, 80u, 84u);
    const uint lx = ldims[level];
    const uint base = push.pyramid_off + lstart[level];

    const vec2 uv_c = ndc * 0.5f + 0.5f;
    const vec2 half_uv = vec2(half_x, half_y) * 0.5f;
    const vec2 uv_min = clamp(uv_c - half_uv, vec2(0.0f), vec2(1.0f));
    const vec2 uv_max = clamp(uv_c + half_uv, vec2(0.0f), vec2(1.0f));
    const uvec2 t_min = uvec2(clamp(uvec2(uv_min * float(lx)), uvec2(0u), uvec2(lx - 1u)));
    const uvec2 t_max = uvec2(clamp(uvec2(uv_max * float(lx)), uvec2(0u), uvec2(lx - 1u)));

    bool covered_everywhere = true;
    bool any_sample = false;
    for (uint ty = t_min.y; ty <= t_max.y; ++ty) {
      for (uint tx = t_min.x; tx <= t_max.x; ++tx) {
        const uint packed = cull.words[base + ty * lx + tx];
        if (packed != 0u) {
          any_sample = true;
          if (uintBitsToFloat(packed) >= depth_min) {
            covered_everywhere = false;
          }
        }
      }
    }
    if (any_sample && covered_everywhere) {
      atomicAdd(cull.words[6], 1u);  // occlusion-culled
      return;
    }
  } else if (tcx > 0u && tcy > 0u) {
    // ---- Legacy path: 2x2 tiles around the projected center (L0 only). ----
    const vec2 uv = ndc * 0.5f + 0.5f;
    if (all(greaterThanEqual(uv, vec2(0.0f))) && all(lessThanEqual(uv, vec2(1.0f)))) {
      // Sample the 2x2 tile footprint around the projected center.
      const uvec2 tile_min = uvec2(clamp(uvec2(uvec2(uv * vec2(float(tcx), float(tcy)))),
                                         uvec2(0u), uvec2(tcx - 1u, tcy - 1u)));
      bool covered_everywhere = true;
      bool any_sample = false;
      for (uint dy = 0u; dy < 2u; ++dy) {
        for (uint dx = 0u; dx < 2u; ++dx) {
          const uvec2 t = uvec2(min(tile_min.x + dx, tcx - 1u),
                                min(tile_min.y + dy, tcy - 1u));
          const uint packed = cull.words[push.pyramid_off + t.y * tcx + t.x];
          const float scene_max_depth = uintBitsToFloat(packed);
          if (packed != 0u) {
            any_sample = true;
            // Tile is occluding when its farthest depth is NEARER than the
            // sphere's nearest possible depth.
            if (scene_max_depth < depth_min) {
              covered_everywhere = covered_everywhere && true;
            } else {
              covered_everywhere = false;
            }
          }
        }
      }
      if (any_sample && covered_everywhere) {
        atomicAdd(cull.words[6], 1u);  // occlusion-culled
        return;
      }
    }
  }

  // ---- LOD: distance bands (near/mid/far). ----
  const float dist = length(center);
  uint lod = 0u;
  if (dist > 18.0f) lod = 1u;
  if (dist > 40.0f) lod = 2u;

  // Per-instance bias can force a coarser band (never finer).
  const uint bias = cull.words[push.lod_off + i];
  lod = max(lod, bias);

  const uint slot = atomicAdd(cull.words[1], 1u);
  if (lod == 0u) {
    cull.words[push.comp0_off + slot] = i;
    atomicAdd(cmd0[1], 1u);
  } else if (lod == 1u) {
    cull.words[push.comp1_off + slot] = i;
    atomicAdd(cmd1[1], 1u);
  } else {
    cull.words[push.comp2_off + slot] = i;
    atomicAdd(cmd2[1], 1u);
  }
  atomicAdd(cull.words[4], 1u);  // stats_accepted_total
}
