#version 450

// gen_cube_ring.comp — per-frame instance producer for the dual-queue
// pipeline: fills one frame's ring slot with an identity compaction list
// and two animated cube instances. Invoked once per cube (2 invocations);
// invocation 0 also writes the identity list words.
//
// Buffer layout (std430, flat words — mirrors gpu_objects.vert):
//   [0 .. N-1]      identity list: word i = i
//   [N + i*8 .. ]   instance i: pos.xyz, scale, color.rgb, unused
//
// Push constants:
//   frame_index — animation phase; cube k sits at
//                 x = 10, y = 0, z = -(frame*10 + (k+1)*8)

layout(local_size_x = 2, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer RingBuffer {
  uint words[];
} ring;

layout(push_constant) uniform Push {
  uint frame_index;
  uint spacing_bits;  // packed float, z spacing per frame (10.0)
} push;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  const uint n = 2u;  // kCubes

  // Both invocations cooperate on the identity list.
  if (i < n) {
    ring.words[i] = i;
  }
  barrier();
  memoryBarrierBuffer();

  const float spacing = uintBitsToFloat(push.spacing_bits);
  const uint base = n + i * 8u;
  const float px = spacing;
  const float py = 0.0f;
  const float pz = -(float(push.frame_index) * spacing +
                     (float(i) + 1.0f) * 8.0f);
  ring.words[base + 0u] = floatBitsToUint(px);
  ring.words[base + 1u] = floatBitsToUint(py);
  ring.words[base + 2u] = floatBitsToUint(pz);
  ring.words[base + 3u] = floatBitsToUint(0.7f);          // scale
  ring.words[base + 4u] = floatBitsToUint(0.2f + 0.2f * float(i));
  ring.words[base + 5u] = floatBitsToUint(0.4f);
  ring.words[base + 6u] = floatBitsToUint(0.9f);
  ring.words[base + 7u] = 0u;                             // unused
}
